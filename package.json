{
	"author": "joabssilveira",
	"dependencies": {
		"@redis/search": "1.1.3",
		"dotenv": "17.4.2",
		"fwork-jsts-common": "2.0.21",
		"mongoose": "9.9.4",
		"mysql2": "3.24.2",
		"pg": "8.23.0",
		"redis": "6.2.1",
		"sequelize": "6.37.8",
		"tedious": "20.0.0",
		"uuidv7": "1.2.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/pg": "^8.23.1",
		"husky": "9.1.7",
		"standard-version": "9.5.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=10"
	},
	"files": [
		"dist",
		"src"
	],
	"homepage": "https://github.com/joabssilveira/fwork-jsts-db",
	"keywords": [
		"database",
		"db",
		"mongoose",
		"sequelize",
		"redis",
		"extension"
	],
	"license": "MIT",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"name": "fwork-jsts-db",
	"prettier": {
		"printWidth": 80,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "es5"
	},
	"scripts": {
		"build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
		"prepare": "husky",
		"release": "standard-version",
		"pub": "npm run build && npm run release && git push --follow-tags origin main && npm publish"
	},
	"version": "2.0.17",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js"
		}
	}
}
